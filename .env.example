# 추출 알고리즘 실행 시에만 필요 (데이터만 쓸 거면 불필요)
# 실제 값을 채운 뒤 이 파일을 .env 로 복사하세요.

# 2단계 LLM 판정에 필요
ANTHROPIC_API_KEY=sk-ant-your-key-here

# 임베딩 캐시 경로 (선택, 기본값 ./embeddings-cache.json)
# EMBEDDINGS_FILE=./embeddings-cache.json

# DB 적재/승격 시에만 (선택 — --no-db 로 실행하면 불필요)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
